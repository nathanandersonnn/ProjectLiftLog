<h1>Goals</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>goalID</th>
            <th>userID</th>
            <th>goalType</th>
            <th>targetValue</th>
            <th>createdDate</th>
            <th>completedDate</th>
            <th>exercise</th>
            {{!-- <th></th> --}}
        </tr>
    </thead>

    <tbody>
        {{#each goals}}
        <tr>
            <td>{{this.goalID}}</td>
            <td>{{this.userID}}</td>
            <td>{{this.goalType}}</td>
            <td>{{this.targetValue}}</td>
            <td>{{this.createdDate}}</td>
            <td>{{this.completedDate}}</td>
            <td>{{this.name}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create a Goal</h2>
<form class='cuForm' id='create_goal_form' method='POST' action='/goals-create'>
    <label for='create_goal_userID'>User: </label>
    <select name='create_goal_userID' id='create_goal_userID' required>
        <option value='' disabled selected>Select a User</option>
        {{#each users}}
        <option value='{{this.userID}}'>{{this.username}}</option>
        {{/each}}
    </select>

    <label for='create_goal_type'>Goal Type: </label>
    <input type='text' name='create_goal_goalType' id='create_goal_goalType' required />

    <label for='create_goal_targetValue'>Target Value: </label>
    <input type='number' step='0.01' name='create_goal_targetValue' id='create_goal_targetValue' min='0' />

    <label for='create_goal_exerciseID'>Exercise (optional): </label>
    <select name='create_goal_exerciseID' id='create_goal_exerciseID'>
        <option value='' selected>&lt; None &gt;</option>
        {{#each exercises}}
        <option value='{{this.exerciseID}}'>{{this.name}}</option>
        {{/each}}
    </select>

    <label for='create_goal_createdDate'>Created Date: </label>
    <input type='date' name='create_goal_createdDate' id='create_goal_createdDate' required />

    <label for='create_goal_completedDate'>Completed Date (optional): </label>
    <input type='date' name='create_goal_completedDate' id='create_goal_completedDate' />
    
    <input type='submit' />
</form>

