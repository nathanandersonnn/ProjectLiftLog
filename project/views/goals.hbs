<h1>Goals</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>goalID</th>
            <th>userID</th>
            <th>goalType</th>
            <th>targetValue</th>
            <th>createdDate</th>
            <th>completedDate</th>
            <th>exercise</th>
            {{!-- <th></th> --}}
        </tr>
    </thead>

    <tbody>
        {{#each goals}}
        <tr>
            <td>{{this.goalID}}</td>
            <td>{{this.userID}}</td>
            <td>{{this.goalType}}</td>
            <td>{{this.targetValue}}</td>
            <td>{{this.createdDate}}</td>
            <td>{{this.completedDate}}</td>
            <td>{{this.name}}</td>

            {{! DELETE form }}
            {{!-- <form id='delete_goal_form'>
                <input type='hidden' name='delete_goal_id' value='{{this.goalID}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form> --}}
        </tr>
        {{/each}}
    </tbody>
</table>

