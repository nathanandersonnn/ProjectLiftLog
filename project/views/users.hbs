<h1>Users</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>userID</th>
            <th>email</th>
            <th>username</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{#each users}}
        <tr>
            <td>{{this.userID}}</td>
            <td>{{this.email}}</td>
            <td>{{this.username}}</td>

            {{! DELETE form }}
