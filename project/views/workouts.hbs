<h1>Workouts</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>workoutID</th>
            <th>username</th>
            <th>workoutDate</th>
            <th>notes</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {{#each workouts}}
        <tr>
            <td>{{this.workoutID}}</td>
            <td>{{this.username}}</td>
            <td>{{this.workoutDate}}</td>
            <td>{{this.notes}}</td>

            {{! DELETE form }}
            <form id='delete_workout_form'>
                <input type='hidden' name='delete_workout_id' value='{{this.workoutID}}' />
                <td>
                    <button type='submit'>
                        Delete
                    </button>
                </td>
            </form>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create a Workout</h2>
<form class='cuForm' id='create_workout_form'>
    <label for='create_workout_userID'>User: </label>
    <select name='create_workout_userID' id='create_workout_userID' required>
        <option value='' disabled selected>Select a User</option>
        {{#each users}}
        <option value='{{this.userID}}'>{{this.username}}</option>
        {{/each}}
    </select>

    <label for='create_workout_date'>Workout Date: </label>
    <input type='datetime-local' name='create_workout_date' id='create_workout_date' required />

    <label for='create_workout_notes'>Notes: </label>
    <input type='text' name='create_workout_notes' id='create_workout_notes' maxlength='255' />

    <input type='submit' />
</form>

{{! UPDATE form }}
<h2>Update a Workout</h2>
<form class='cuForm' id='update_workout_form'>
    <label for='update_workout_id'>Workout to Update: </label>
    <select name='update_workout_id' id='update_workout_id' required>
        <option value='' disabled selected>Select a Workout</option>
        {{#each workouts}}
        <option value='{{this.workoutID}}'>
            {{this.workoutID}}
            -
            {{this.username}}
            -
            {{this.workoutDate}}
        </option>
        {{/each}}
    </select>

    <label for='update_workout_userID'>User: </label>
    <select name='update_workout_userID' id='update_workout_userID'>
        <option value='' disabled selected>Select a User</option>
        {{#each users}}
        <option value='{{this.userID}}'>{{this.username}}</option>
        {{/each}}
    </select>

    <label for='update_workout_date'>Workout Date: </label>
    <input type='datetime-local' name='update_workout_date' id='update_workout_date' />

    <label for='update_workout_notes'>Notes: </label>
    <input type='text' name='update_workout_notes' id='update_workout_notes' maxlength='255' />

    <input type='submit' />
</form>
