<h1>Workouts</h1>

{{! READ table }}
<table>
    <thead>
        <tr>
            <th>workoutID</th>
            <th>username</th>
            <th>workoutDate</th>
            <th>notes</th>
            {{!-- <th></th> --}}
        </tr>
    </thead>

    <tbody>
        {{#each workouts}}
        <tr>
            <td>{{this.workoutID}}</td>
            <td>{{this.username}}</td>
            <td>{{this.workoutDate}}</td>
            <td>{{this.notes}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>

{{! CREATE form }}
<h2>Create a Workout</h2>
<form class='cuForm' id='create_workout_form' method='POST' action='/workouts-create'>
    <label for='create_workout_userID'>User: </label>
    <select name='create_workout_userID' id='create_workout_userID' required>
        <option value='' disabled selected>Select a User</option>
        {{#each users}}
        <option value='{{this.userID}}'>{{this.username}}</option>
        {{/each}}
    </select>

    <label for='create_workout_workoutDate'>Workout Date: </label>
    <input type='date' name='create_workout_workoutDate' id='create_workout_workoutDate' required />
    <label for='create_workout_notes'>Notes: </label>
    <input type='text' name='create_workout_notes' id='create_workout_notes' maxlength='255' />

    <input type='submit' />
</form>