<div class="page-header">
    <h1>Exercises</h1>
    <p>Keep your movements and equipment organized.</p>
</div>

{{! READ table }}
<div class="table-card"><table>
    <thead>
        <tr>
            <th>exerciseID</th>
            <th>name</th>
            <th>muscleGroup</th>
            <th>equipment</th>
            {{!-- <th></th> --}}
        </tr>
    </thead>

    <tbody>
        {{#each exercises}}
        <tr>
            <td>{{this.exerciseID}}</td>
            <td>{{this.name}}</td>
            <td>{{this.muscleGroup}}</td>
            <td>{{this.equipment}}</td>
        </tr>
        {{/each}}
    </tbody>
</table></div>

{{! CREATE form }}
<h2>Create an Exercise</h2>
<div class="form-card"><form class='cuForm' id='create_exercise_form' method='POST' action='/exercises-create'>
    <div class="field">
    <label for='create_exercise_name'>Name: </label>
    <input type='text' name='create_exercise_name' id='create_exercise_name' required />
    </div><div class="field">

    <label for='create_exercise_muscleGroup'>Muscle Group: </label>
    <input type='text' name='create_exercise_muscleGroup' id='create_exercise_muscleGroup' />
    </div><div class="field">

    <label for='create_exercise_equipment'>Equipment: </label>
    <input type='text' name='create_exercise_equipment' id='create_exercise_equipment' />
    </div>

    <input type='submit' />
</form></div>
